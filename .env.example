# Backend API URL for the frontend
VITE_API_BASE_URL=http://localhost:5000

# YouTube API Keys Configuration
VITE_YOUTUBE_API_KEY_COUNT=3
VITE_YOUTUBE_API_KEY_1=your_youtube_api_key_1
VITE_YOUTUBE_API_KEY_2=your_youtube_api_key_2
VITE_YOUTUBE_API_KEY_3=your_youtube_api_key_3
# VITE_YOUTUBE_API_KEY_4=...

# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq API Key (For local development or to set in remote Supabase secrets)
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

